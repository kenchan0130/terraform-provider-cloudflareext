{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'github>aquaproj/aqua-renovate-config#2.13.0',
    'group:allNonMajor',
  ],
  automerge: true,
  platformAutomerge: true,
  dependencyDashboard: {
    enabled: false,
  },
  labels: [
    'dependencies',
  ],
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 5,
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      '* * * * 0,6',
    ],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  packageRules: [],
  customManagers: [],
}
